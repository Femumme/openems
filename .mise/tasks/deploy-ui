#!/bin/bash
#MISE description="Deploy UI build to a remote Pi (arg: edge target, default: pi)"

set -e

get_host() {
    case $1 in
        pi) echo "192.168.89.204" ;;
        revpi) echo "revpi134791.local" ;;
        *) echo "unknown host: $1" >&2 && exit 1 ;;
    esac
}

get_user() {
    case $1 in
        pi) echo "admin" ;;
        revpi) echo "pi" ;;
        *) echo "unknown host: $1" >&2 && exit 1 ;;
    esac
}

edge="${1:-pi}"
host=$(get_host "$edge")
user=$(get_user "$edge")

RED='\033[0;31m'
NC='\033[0m'

echo -e "${RED}WARNING: You are about to deploy ui to edge '${edge}' on host '${host}'.${NC}"
read -p "Are you sure you want to continue? (yes/no): " confirm

if [[ ! "$confirm" =~ ^[Yy][Ee][Ss]$ ]]; then
    echo "Deployment aborted."
    exit 1
fi

ssh "$user@$host" "mkdir -p ~/ui_cp_tmp"

echo "packing files..."
(cd ./ui/target && zip -r ../../build/ui.zip ./*)

echo "copy build to server..."
scp -r ./build/ui.zip "$user@$host:~/ui_cp_tmp"

echo "preparing files on server"

SSH_CMD="$(cat <<-EOF
mkdir -p ~/ui_cp_tmp/ui
unzip ~/ui_cp_tmp/ui.zip -d ~/ui_cp_tmp/ui
sudo rm -rf /var/www/openems-pi.local/html
sudo mkdir /var/www/openems-pi.local/html
sudo cp -r ~/ui_cp_tmp/ui/* /var/www/openems-pi.local/html
rm -rf ~/ui_cp_tmp
EOF
)"

ssh "$user@$host" "$SSH_CMD"

echo "done"
